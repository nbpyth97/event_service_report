# Postgres (used by both the `postgres` and `backend` docker-compose services;
# the backend also builds DATABASE_URL from these — POSTGRES_HOST defaults to
# "postgres", the docker-compose service name, so it's only needed if the
# backend connects to Postgres some other way, e.g. running outside compose)
POSTGRES_DB=meeting_scheduler
POSTGRES_USER=meeting_scheduler
POSTGRES_PASSWORD=changeme

# Backend
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SECRET_KEY=changeme-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
ENVIRONMENT=local

# Backup (only used by the backup_postgres compose profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

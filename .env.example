# Postgres (used by both the `postgres` and `backend` docker-compose services)
POSTGRES_DB=meeting_scheduler
POSTGRES_USER=meeting_scheduler
POSTGRES_PASSWORD=changeme

# Backend
DATABASE_URL=postgresql+asyncpg://meeting_scheduler:changeme@postgres:5432/meeting_scheduler
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SECRET_KEY=changeme-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=local

# Backup (only used by the backup_postgres compose profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
